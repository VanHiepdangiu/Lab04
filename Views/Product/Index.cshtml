@{
    ViewData["Title"] = "Danh sách sản phẩm";
}
<h2>Danh sách sản phẩm</h2>
<hr />

<div class="row">
    @if (ViewBag.Categories != null)
    {
        var categories = ViewBag.Categories as List<lab04.Models.Category>;
        var currentCategoryId = (int)ViewBag.CurrentCategoryId;
        <div class="col-md-3">
            <h4>DANH MỤC</h4>
            <ul class="list-group">
                <li class="list-group-item @(currentCategoryId == 0 ? "active" : "")">
                    <a asp-controller="Product" asp-action="Index" style="text-decoration:none;">Tất cả</a>
                </li>
                @foreach (var c in categories)
                {
                    <li class="list-group-item @(currentCategoryId == c.Id ? "active" : "")">
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@c.Id" style="text-decoration:none;">@c.Name</a>
                    </li>
                }
            </ul>
        </div>
    }

    @if (ViewBag.Products != null)
    {
        var products = ViewBag.Products as List<lab04.Models.Product>;
        <div class="col-md-9">
            <div class="row">
                @foreach (var p in products)
                {
                    <div class="col-md-4 mb-3">
                        <div class="card h-100">
                            <img src="@p.Image" class="card-img-top" alt="@p.Name" style="height:180px; object-fit:cover;" />
                            <div class="card-body">
                                <h5 class="card-title">@p.Name</h5>
                                <p class="text-danger"><strong>@p.Price.ToString("N0") ₫</strong> <del class="text-muted">@p.PriceOld.ToString("N0") ₫</del></p>
                                <a asp-controller="Product" asp-action="Detail" asp-route-id="@p.Id" class="btn btn-primary btn-block">Chi tiết</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
