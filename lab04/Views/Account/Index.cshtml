@{
    ViewData["Title"] = "Danh sách Account";
}
<h1>Danh sách Account</h1>

@if (ViewBag.Accounts != null)
{
    var accounts = ViewBag.Accounts as List<lab04.Models.Account>;
    <div class="row">
        @foreach (var account in accounts)
        {
            <div class="col-md-4">
                <div class="thumbnail">
                    <img src="@account.Avatar" alt="Avatar" style="width:100%; height:200px; object-fit:cover;" />
                    <div class="caption">
                        <h3>@account.Name</h3>
                        <p>
                            @account.Bio
                        </p>
                        <p>
                            <a href="@Url.Action("Profile", "Account", new { id = account.Id })" class="btn btn-success btn-block">Profile</a>
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
}
